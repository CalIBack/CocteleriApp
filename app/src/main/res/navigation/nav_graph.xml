<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragmentLista">

    <fragment
        android:id="@+id/fragmentLista"
        android:name="com.example.cocktailapp.ui.lista.ListaFragment"
        android:label="@string/titulo_lista"
        tools:layout="@layout/fragment_lista">
        <action
            android:id="@+id/accion_lista_a_detalle"
            app:destination="@id/fragmentDetalle" />
    </fragment>

    <fragment
        android:id="@+id/fragmentDetalle"
        android:name="com.example.cocktailapp.ui.detalle.DetalleFragment"
        android:label="@string/titulo_detalle"
        tools:layout="@layout/fragment_detalle">
        <argument
            android:name="idCoctel"
            app:argType="string" />
    </fragment>

</navigation>
