<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/drinkListFragment">

    <fragment
        android:id="@+id/drinkListFragment"
        android:name="com.example.cocktailapp.DrinkListFragment"
        android:label="Cócteles"
        tools:layout="@layout/fragment_drink_list">
        <action
            android:id="@+id/action_drinkList_to_drinkDetail"
            app:destination="@id/drinkDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/drinkDetailFragment"
        android:name="com.example.cocktailapp.DrinkDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_drink_detail">
        <argument
            android:name="drinkId"
            app:argType="string" />
    </fragment>

</navigation>