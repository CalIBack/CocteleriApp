<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- [Mejora] NestedScrollView: la versión de ScrollView recomendada por AndroidX. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- La tarjeta recorta la foto con esquinas redondeadas. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imageDetail"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:contentDescription="@string/cd_drink_image"
                    android:scaleType="centerCrop" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/text_dark"
                android:textStyle="bold"
                tools:text="Margarita" />

            <!-- [Mejora] Etiquetas con categoría, tipo y vaso. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCategory"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="@color/text_dark"
                    app:chipBackgroundColor="@color/amber_container"
                    app:chipStrokeWidth="0dp"
                    tools:text="Ordinary Drink" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAlcoholic"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="@color/text_dark"
                    app:chipBackgroundColor="@color/wine_container"
                    app:chipStrokeWidth="0dp"
                    tools:text="Alcoholic" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGlass"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="@color/text_dark"
                    app:chipBackgroundColor="@color/amber_container"
                    app:chipStrokeWidth="0dp"
                    tools:text="Cocktail glass" />

            </com.google.android.material.chip.ChipGroup>

            <!-- [Mejora] Cada sección va en su propia tarjeta. Antes eran títulos y textos sueltos. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_ingredients"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/wine_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="6dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/text_dark"
                        tools:text="•  1 1/2 oz Tequila\n•  1/2 oz Triple sec" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_instructions"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/wine_secondary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/text_dark"
                        tools:text="Rub the rim of the glass with the lime slice..." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/amber_primary" />

    <include
        android:id="@+id/message"
        layout="@layout/view_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
